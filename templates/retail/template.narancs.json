            "text": "09:00 – 20:00"
          },
          {
            "icon": "🌤️",
            "title": {
              "en": "Saturday",
              "hu": "Szombat"
            },
            "text": "09:00 – 18:00"
          },
          {
            "icon": "☀️",
            "title": {
              "en": "Sunday",
              "hu": "Vasárnap"
            },
            "text": "10:00 – 16:00"
          }
        ]
      }
    },
    {
      "ref": "s5",
      "name": {
        "en": "Loyalty club",
        "hu": "Törzsvásárlói klub"
