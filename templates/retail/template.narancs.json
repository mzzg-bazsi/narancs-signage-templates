          {
            "icon": "🎒",
            "title": {
              "en": "City backpack",
              "hu": "Városi hátizsák"
            },
            "text": {
              "en": "Laptop pocket, 22 L",
              "hu": "Laptoptartó, 22 l"
            }
          }
        ]
      }
    },
    {
      "ref": "s4",
      "name": {
        "en": "Opening hours",
        "hu": "Nyitvatartás"
