      "data": {
        "url": "https://example.com/club",
        "title": {
          "en": "Join our loyalty club",
          "hu": "Csatlakozz a törzsvásárlói klubhoz"
        },
        "text": {
          "en": "Collect points with every purchase",
          "hu": "Gyűjts pontokat minden vásárlással"
        }
      }
    },
    {
      "ref": "s6",
      "name": {
        "en": "Feedback form",
        "hu": "Visszajelzés űrlap"
      },
      "type": "form",
      "duration": 45,
      "data": {
        "form_id": "f1"
      }
    }
